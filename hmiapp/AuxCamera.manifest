<?xml version="1.0" encoding="utf-8"?>
<plugin>
	<name>AuxCamera</name>
	<type>App</type>
	<file>{pluginDir}/AuxCamera</file>
	<config>
		<autoStart>yes</autoStart>
		<dependencies>
			<pluginAppConnector>
				<type>Etch</type>
				<id>212</id>
				<asyncCallbacks>yes</asyncCallbacks>
			</pluginAppConnector>
		</dependencies>
		<parameters>
			<DescFile>{pluginDir}/AuxCamera.xml</DescFile>
			<ImageDBFile>{pluginDir}/AuxCamera_ALL_Images.zip</ImageDBFile>
		</parameters>
	</config>
</plugin>
